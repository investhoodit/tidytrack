	<queryString language="SQL">
		<![CDATA[SELECT 
    t.title AS task_title,
    t.description,
    t.status,
    t.due_date,
    u.name AS assigned_to
FROM 
    tasks t
LEFT JOIN 
    users u ON t.assigned_to = u.userID
ORDER BY 
    t.due_date ASC]]>
	</queryString>
